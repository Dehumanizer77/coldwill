{
  "listen_addr": "127.0.0.1:8088",
  "public_base_url": "https://dms.example.com",
  "smtp_addr": "127.0.0.1:25",
  "from_email": "dms@example.com",
  "user_email": "you@example.com",

  "_envelopes": "Každá obálka má vlastný súbor a vlastných príjemcov: tá istá obálka viacerým = záloha, rôzne obálky rôznym ľuďom = rozdelenie znalostí. Starý zápis envelope_path + friend_email stále funguje.",
  "envelopes": [
    {
      "id": "passphrase",
      "path": "/data/envelope-passphrase.asc",
      "subject": "Dôležité — dedičstvo: passphrase",
